{% if nbrePage >0 %}
                  <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item {{pageEncours <=1 ? 'disabled' }} ">
                            <a class="page-link" href="{{path(pathName,{page:pageEncours - 1})}}" tabindex="-1" aria-disabled="true">Précédent</a>
                        </li>
                          {% for  index in 1..nbrePage %}
                                <li class="page-item {{ index==pageEncours ? 'active'  }}"><a class="page-link" href="{{path(pathName)}}?page={{index}}">{{index}}</a></li>  
                          {% endfor %}
                        <li class="page-item">
                            <a class="page-link {{pageEncours >=nbrePage ? 'disabled'}}" href="{{path(pathName,{page:pageEncours + 1 }) }}">Suivant</a>
                        </li>
                    </ul>
                </nav>
{% endif %}