{% extends "base.html.twig" %}
      {% block body %}
    <!-- Contenu principal -->
       <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Liste des Employes {% if departement %} du Departement {{departement.name}}{% endif %} </h2>
            <a href="{{path('app_employe_add')}}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Nouveau Employe
            </a>
        </div>
        <!-- Filtres et recherche -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
               {{form_start(formSearchEmp)}}    <!-- <form> -->
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="input-group">
                            {{form_widget(formSearchEmp.numero)}} <!-- <input > -->
                        </div>
                    </div>
                    <div class="col-md-3">
                            {{form_widget(formSearchEmp.isArchived)}} <!-- <input > -->
                    </div>
                    <div class="col-md-3">
                      
                            {{form_widget(formSearchEmp.departement)}} <!-- <input > -->
                      
                    </div>
                   <div class="col-md-3">
                      <button class="btn btn-outline-secondary" type="submit">
                                <i class="fas fa-search"></i> Rechercher
                      </button>
                    </div>
                    
                </div>
              {{form_end(formSearchEmp)}} <!-- </form> -->
            </div>
        </div>
        
        <!-- Liste des comptes -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
            {% if employes|length >0 %}
                  {% include 'components/messageFlash.html.twig' %}
                  <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Numero</th>
                                <th>Nom et Prenom</th>
                                <th>Telephone</th>
                                <th>Date Embauche</th>
                                <th>Departement</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for employe in employes %}
                                <tr>
                                <td>{{employe.numero}}</td>
                                <td>{{employe.nomComplet}}</td>
                                <td>{{employe.telephone}}</td>
                                <td>{{employe.embaucheAt|date("d/m/Y")}}</td>
                                <td>{{employe.departement.name}}</td>
                                <td>{% include "components/statut.html.twig" with {active:employe.isArchived, color:'success'} %}</td>
                                <td>
                                    <div class="btn-group">
                                        <a href="#" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i> Detail
                                        </a>
                                        <a href="#" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a href="#" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Archiver
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                           
                        </tbody>
                    </table>
                </div>
                <!-- Pagination -->
                      {% include "components/pagination.html.twig" with {nbrePage:nbrePage,pageEncours:pageEncours,pathName:'app_employe_list'} %}

                 {% else %}
                     {% if departement %}
                           <div class="alert alert-danger" role="alert">
                                  La liste des Employes  est vide
                           </div>
                     {% else %}
                           <div class="alert alert-danger" role="alert">
                                  Le Departement n'existe pas
                           </div>
                     {% endif %}
                   
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

 